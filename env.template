# ========================================
# Bila Waya Billing System: environment
# Copy this file to .env and fill it in. Never commit .env.
# ========================================

# --- Server ---
NODE_ENV=development
PORT=5000
# Where the Next.js portal is served from (CORS)
FRONTEND_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of this server (nginx = 1)
TRUST_PROXY=1

# --- Database (MySQL via Prisma) ---
DATABASE_URL="mysql://user:password@localhost:3306/bila_waya"

# --- Auth ---
# At least 32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- M-Pesa (Safaricom Daraja) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS address of this backend (no trailing slash). Safaricom must be able to reach it.
MPESA_CALLBACK_BASE_URL=https://api.yourdomain.com
# At least 16 random characters. Becomes part of the callback URL so nobody else can fake a payment:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=
# Optional extra protection: comma separated list of Safaricom callback IPs to accept
MPESA_CALLBACK_ALLOWED_IPS=

# --- MikroTik ---
# false = dev mode: no router is contacted and payments still "activate"
MIKROTIK_ENABLED=false
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=billing
MIKROTIK_PASSWORD=
MIKROTIK_PORT=8728

# --- Behaviour ---
# How often expired customers are removed from the router
SWEEP_INTERVAL_SECONDS=60
# Only if this server is on the same LAN as your customers
ENABLE_ARP_LOOKUP=false

# --- Frontend (put these in frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:5000
# NEXT_PUBLIC_PROJECT_NAME=Bila Waya
